# Base image - uses Node.js on lightweight Alpine Linux
FROM node:22-alpine

# Sets the working directory inside container to /app
WORKDIR /app

# Copy dependency files first for better caching
# This includes both package.json and package-lock.json
COPY package*.json ./

# Copy the rest of the application code
COPY . .

# Build the Next.js application
RUN npm install

# Configure the port
EXPOSE 3000

# Start the application using npm start (production mode, not for hot reloading)
CMD ["npm", "run", "dev"]


# The development mode is slower in Docker for several reasons:

#     Volume Mounting
    
#     In development, files need to be synced between host and container
#     File system operations are slower through Docker's volume mounting
#     Hot Reloading
    
#     Next.js dev server watches for file changes
#     File system watching through Docker is less efficient
#     No Build Optimization
    
#     Development mode skips many production optimizations
#     Code is not minified or bundled efficiently