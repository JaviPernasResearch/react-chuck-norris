# Base image - uses Node.js on lightweight Alpine Linux
FROM node:22-alpine

# Sets the working directory inside container to /app
WORKDIR /app

# Copy dependency files first for better caching
# This includes both package.json and package-lock.json
COPY package*.json ./

# Install ALL dependencies (including devDependencies needed for build)
RUN npm ci

# Copy the rest of the application code
COPY . .

# Build the Next.js application
RUN npm run build

# Configure the port
EXPOSE 4000

# Start the application using npm start (production mode, not for hot reloading)
CMD ["npm", "start"]

# Start in development mode: However, this is not recommended for production containers. Development mode should typically be run locally, not in containers.
#CMD ["npm", "run", "dev"]

